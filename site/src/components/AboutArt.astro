---
const { kind } = Astro.props;
---
{kind === 'idea' && (
  <svg viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path class="a-fill" d="M48 14a22 22 0 0 0-12 40c3 2 4 5 4 8h16c0-3 1-6 4-8a22 22 0 0 0-12-40z" />
    <path d="M40 72h16M42 80h12" />
    <path class="a-ray" d="M48 3v4M16 18l3 3M80 18l-3 3M6 44h4M86 44h4" />
  </svg>
)}
{kind === 'team' && (
  <svg viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle class="a-fill" cx="48" cy="32" r="11" /><path d="M28 74c0-12 9-20 20-20s20 8 20 20" />
    <circle cx="20" cy="42" r="7" /><path d="M6 72c0-8 6-14 14-14M90 72c0-8-6-14-14-14" /><circle cx="76" cy="42" r="7" />
  </svg>
)}
{kind === 'clients' && (
  <svg viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path class="a-fill" d="M14 20h52a6 6 0 0 1 6 6v26a6 6 0 0 1-6 6H38l-12 10V58h-12a6 6 0 0 1-6-6V26a6 6 0 0 1 6-6z" />
    <path d="M60 70h22a6 6 0 0 0 6-6V42" />
    <path class="a-ray" d="M40 31l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z" />
  </svg>
)}
{kind === 'today' && (
  <svg viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect class="a-fill" x="8" y="14" width="80" height="56" rx="8" />
    <path d="M30 82h36M48 70v12" />
    <path class="a-ray" d="M20 56l14-14 10 8 20-22 10 8" /><path d="M64 28h10v10" />
  </svg>
)}
{kind === 'craft' && (
  <svg viewBox="0 0 200 160" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <g opacity=".35"><path d="M20 20h160M20 60h160M20 100h160M20 140h160M20 20v120M60 20v120M100 20v120M140 20v120M180 20v120" /></g>
    <path class="a-draw" d="M26 128C50 30 100 30 120 84s46 40 56-62" stroke-width="3.2" />
    <g fill="var(--bg, #fff)"><rect x="20" y="122" width="12" height="12" /><rect x="170" y="16" width="12" height="12" /><circle cx="76" cy="46" r="6" /><circle cx="140" cy="108" r="6" /></g>
    <path opacity=".6" d="M32 128L76 46M182 22L140 108" stroke-dasharray="4 5" />
  </svg>
)}
{kind === 'speed' && (
  <svg viewBox="0 0 200 160" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path class="a-dash" d="M10 44h60M22 72h70M6 100h54M30 128h50" opacity=".55" />
    <path class="a-fill" d="M118 8L74 90h34l-10 62 54-86h-36z" stroke-width="3" />
  </svg>
)}
{kind === 'honesty' && (
  <svg viewBox="0 0 200 160" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect class="a-fill" x="40" y="10" width="120" height="140" rx="12" />
    <path d="M62 44l8 8 14-16M62 80l8 8 14-16M62 116l8 8 14-16" stroke-width="3" />
    <path d="M100 44h42M100 80h42M100 116h30" opacity=".6" />
  </svg>
)}
{kind === 'care' && (
  <svg viewBox="0 0 200 160" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle class="a-ring" cx="100" cy="80" r="70" opacity=".25" /><circle class="a-ring r2" cx="100" cy="80" r="52" opacity=".4" />
    <path class="a-fill a-beat" d="M100 118S60 94 60 66a20 20 0 0 1 40-6 20 20 0 0 1 40 6c0 28-40 52-40 52z" stroke-width="3" />
  </svg>
)}
