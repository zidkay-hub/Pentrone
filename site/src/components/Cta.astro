---
import { FIVERR } from '../data/site.js';
const { title = 'stand out?', lead = "Tell us about your project. You'll get a clear plan, a fair quote and a reply within one working day." } = Astro.props;
---
<section class="cta-sec" id="contact">
  <canvas data-spray="c" aria-hidden="true"></canvas>
  <img class="orn" src="/img/mark-globe.png" alt="" data-speed="-0.4" />
  <div class="cta-grid">
    <div>
      <h2 class="rvw" data-words>Ready to <em>{title}</em></h2>
      <p class="lead" data-rv>{lead}</p>
      <div class="contact-list" data-rv>
        <a href="mailto:info@pentrone.org"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M4 7l8 6 8-6" /></svg>info@pentrone.org</a>
        <a href="tel:+971543700840"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg>+971 54 370 0840</a>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6.2 7-11a7 7 0 0 0-14 0c0 4.8 7 11 7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>Abu Dhabi, United Arab Emirates</span>
        <a href={FIVERR} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>Or hire us on Fiverr</a>
      </div>
    </div>
    <form class="form" id="form" data-rv>
      <h3>Get a free quote</h3>
      <div class="two">
        <label>Name<input name="name" required placeholder="Jane Doe" /></label>
        <label>Email<input name="email" type="email" required placeholder="jane@company.com" /></label>
      </div>
      <label>I need help with
        <select name="service">
          <option>A new website</option><option>Mobile app development</option><option>Bug fixing</option><option>SEO</option><option>Speed optimization</option><option>Digital marketing</option><option>Website security</option><option>Content marketing</option><option>Not sure yet</option>
        </select>
      </label>
      <label>Project details<textarea name="msg" placeholder="Goals, timeline, links…"></textarea></label>
      <button class="btn dark lg" type="submit" data-magnetic>Send my request <span class="arr">→</span></button>
      <p class="note">No spam, ever. We reply within one working day.</p>
    </form>
  </div>
</section>
