---
import Base from '../layouts/Base.astro';
import AboutIntro from '../components/AboutIntro.astro';
import ServicesStack from '../components/ServicesStack.astro';
import WorkTrack from '../components/WorkTrack.astro';
import Stats from '../components/Stats.astro';
import Why from '../components/Why.astro';
import Process from '../components/Process.astro';
import Voices from '../components/Voices.astro';
import FiverrProof from '../components/FiverrProof.astro';
import Cta from '../components/Cta.astro';
import { FIVERR } from '../data/site.js';
---
<Base title="Pentrone — Digital agency for websites, apps, SEO & growth" description="Pentrone is a digital agency in Abu Dhabi building websites, mobile apps, SEO, digital marketing and security, and fixing bugs, to help brands stand out and grow." current="home">
    <section class="hero" id="hero">
      <canvas class="spray spray-a" id="sprayA" data-spray="a" aria-hidden="true"></canvas>
      <canvas class="spray spray-b" id="sprayB" data-spray="b" aria-hidden="true"></canvas>

      <h1 id="heroTitle">
        <span class="line"><span>Digital agency <span class="chip" data-chip="1"><svg viewBox="0 0 150 96" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="hc1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#22e883"/><stop offset="1" stop-color="#1a8f5c"/></linearGradient></defs><rect width="150" height="96" fill="url(#hc1)"/><rect x="16" y="14" width="118" height="90" rx="9" fill="#fff"/><circle cx="26" cy="24" r="3" fill="#ff5e13"/><circle cx="35" cy="24" r="3" fill="#ffab00"/><circle cx="44" cy="24" r="3" fill="#22e883"/><rect x="26" y="38" width="52" height="8" rx="4" fill="#06201a"/><rect x="26" y="52" width="38" height="8" rx="4" fill="#22e883"/><rect x="26" y="68" width="60" height="4" rx="2" fill="#cfdcd7"/><rect x="26" y="77" width="44" height="4" rx="2" fill="#cfdcd7"/><circle cx="108" cy="58" r="20" fill="#22e883" opacity=".3"/><circle cx="108" cy="58" r="12" fill="#1a8f5c"/></svg></span></span></span>
        <span class="line"><span>that makes <span class="chip" data-chip="2"><svg viewBox="0 0 150 96" preserveAspectRatio="xMidYMid slice"><rect width="150" height="96" fill="#06201a"/><g fill="#22e883"><rect x="18" y="62" width="18" height="22" rx="4" opacity=".45"/><rect x="42" y="50" width="18" height="34" rx="4" opacity=".6"/><rect x="66" y="38" width="18" height="46" rx="4" opacity=".75"/><rect x="90" y="24" width="18" height="60" rx="4" opacity=".9"/><rect x="114" y="10" width="18" height="74" rx="4"/></g><path d="M20 56 L48 44 L76 32 L100 20 L124 8" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="124" cy="8" r="5" fill="#fff"/></svg></span> brands</span></span>
        <span class="line"><span><span class="chip stat" data-chip="3">#1 on Google</span> <em>stand out</em></span></span>
      </h1>

      <div class="cta" data-hero-in>
        <a class="btn" data-magnetic href="/work/">See our work</a>
        <a class="btn primary" data-magnetic href="/contact/">Start a project <span class="arr">→</span></a>
      </div>
      <div class="trust" data-hero-in>
        <span class="avs"><img src="/img/avatar-women-44.jpg" alt="" width="34" height="34" /><img src="/img/avatar-men-32.jpg" alt="" width="34" height="34" /><img src="/img/avatar-women-68.jpg" alt="" width="34" height="34" /></span>
        <span><b>350+</b> happy clients · 120+ projects · <a class="fv-link" href={FIVERR} target="_blank" rel="noopener">on Fiverr ↗</a></span>
      </div>
      <span class="scroll-hint">Scroll</span>
    </section>

    <AboutIntro />
    <ServicesStack />
    <WorkTrack />

    <section class="marquee" aria-hidden="true">
      <div class="mrow" data-marquee="-1"><span>Websites <i></i></span><span>Mobile Apps <i></i></span><span>Bug Fixing <i></i></span><span>SEO <i></i></span><span>Marketing <i></i></span><span>Speed <i></i></span><span>Security <i></i></span><span>Content <i></i></span></div>
      <div class="mrow fill" data-marquee="1"><span>Design that wows <i></i></span><span>Code that flies <i></i></span><span>Growth that lasts <i></i></span><span>Design that wows <i></i></span><span>Code that flies <i></i></span><span>Growth that lasts <i></i></span></div>
    </section>

    <Stats />
    <Why />
    <Process />
    <Voices />
    <FiverrProof />
    <Cta />
</Base>
