---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { work } from '../data/site.js';
const cats = ['All', ...new Set(work.map((w) => w.cat))];
---
<Base title="Our Work — Pentrone" description="A selection of websites Pentrone has designed and built for real estate, services and business clients." current="work">
  <PageHero eyebrow="Portfolio" title="Our work speaks for itself" lead="A selection of recent websites we designed, built and launched. Open any project to visit the live site." />

  <div class="sheet">
    <section class="cases">
      <div class="filters" data-rv role="tablist" aria-label="Filter projects">
        {cats.map((c, i) => <button class={i === 0 ? 'on' : ''} data-filter={c}>{c}</button>)}
      </div>
      <div class="case-list">
        {work.map((w, i) => (
          <article class={`case${i % 2 ? ' flip' : ''}`} data-cat={w.cat}>
            <a class="case-shot" href={w.url} target="_blank" rel="noopener" aria-label={`Visit ${w.t}`}>
              <div class="chrome"><i></i><i></i><i></i><span>{w.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span></div>
              <img src={`/img/${w.img}`} alt={`${w.t} website`} loading="lazy" decoding="async" />
            </a>
            <div class="case-info">
              <span class="case-n">0{i + 1}</span>
              <span class="case-cat">{w.cat}</span>
              <h2>{w.t}</h2>
              <p>{w.d}</p>
              <ul class="case-tags">{w.tags.map((t) => <li>{t}</li>)}</ul>
              <a class="btn dark" data-magnetic href={w.url} target="_blank" rel="noopener">Visit live site <span class="arr">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <CtaBanner title="Your project could be next" sub="Join the brands we have helped stand out. Tell us what you are building." />
</Base>
